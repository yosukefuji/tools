    },
    {
      "id": "pbox",
      "name": "駐在所",
      "bg": "room_day",
      "tone": "day",
      "pages": [
        [
          "hotaru",
          "役場の海ほたるです。今日は島の案内を頼まれています"
        ],
        [
          "you",
          "よろしく。島のことを教えてください"
        ],
        [
          "hotaru",
          "波留島は『波が留まる島』と書くんです。この島の潮はちょっと変わっているんですよ"
        ],
        [
          "hotaru",
          "船は朝と昼の一日二便だけ。電気は本土から海底ケーブルで来ていて電波は鉄塔が一本です"
        ],
        [
          "you",
          "ずいぶん本土に頼っているんですね"
        ],
        [
          "hotaru",
          "ええ。だから嵐が来るとちょっと大変です。船は止まります。ケーブルが傷めば停電して鉄塔の予備電池が切れたら電波もなくなります"
        ],
        [
          "hotaru",
          "この駐在所の無線も荒れた空の下ではほとんど届きません"
        ],
        [
          "you",
          "本土から人は来られないのか"
        ],
        [
          "hotaru",
          "海原署の刑事さんも嵐のあいだは来られません。船もヘリも出られませんから。来られるのは嵐が過ぎてからです"
        ],
        [
          "you",
          "嵐が来ると島は孤立するということか"
        ],
        [
          "hotaru",
          "はい。……まあ今日はいい天気ですし。そんなことめったにありませんよ"
        ],
        [
          "you",
          "そうだな。まさかね"
        ],
        [
          "hotaru",
          "さあ島を案内します。まずは港から行きましょう"
        ]
      ]
